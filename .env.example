# Generate a URL-safe value with openssl rand -hex 24.
POSTGRES_PASSWORD=
RADAR_ADMIN_USER=admin
# Optional for local use. Set a unique password of at least 12 bytes before network deployment.
# Single-quote literal values containing $.
RADAR_ADMIN_PASSWORD=
RADAR_BIND=127.0.0.1
RADAR_PORT=8080
RADAR_COOKIE_SECURE=false

# Optional accounts. Set both username and password for each role.
# RADAR_OPERATOR_USER=ops
# RADAR_OPERATOR_PASSWORD=
# RADAR_VIEWER_USER=viewer
# RADAR_VIEWER_PASSWORD=
